<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checked / pressed -->
    <item android:state_checked="true" android:drawable="@drawable/glass_chip_checked" />
    <item android:state_pressed="true" android:drawable="@drawable/glass_chip_checked" />

    <!-- Default (not pressed) -->
    <item android:drawable="@drawable/glass_frost" />
</selector>
