<?xml version="1.0" encoding="utf-8"?>
<!-- Premium glassmorphic panel with glowing edges - matches reference screenshots -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Outer glow effect -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1A60A0FF" />
        </shape>
    </item>
    
    <!-- Main glassmorphic surface -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#40506080" />
            <stroke android:width="1dp" android:color="#6080A0C0" />
        </shape>
    </item>
    
    <!-- Inner highlight for glass effect -->
    <item android:top="5dp" android:left="5dp" android:right="5dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <stroke android:width="0.5dp" android:color="#4080C0FF" />
        </shape>
    </item>
    
</layer-list>