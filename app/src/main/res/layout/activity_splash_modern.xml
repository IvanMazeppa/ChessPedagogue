<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Glassmorphic Splash Screen for Android 15 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".SplashActivity">

    <!-- Status Bar Spacing -->
    <Space
        android:id="@+id/statusBarSpacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Hero Title Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/heroCard"
        style="@style/GameModeCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpacer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <!-- Chess Crown Icon -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Chess Crown"
                android:src="@drawable/ic_white_king" />

            <!-- App Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="serif"
                android:text="ChessPedagogue"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Master Chess with AI Coaching"
                android:textColor="@color/md_theme_light_onSurfaceVariant"
                android:textSize="16sp"
                android:textStyle="italic" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Color Selection Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/colorSelectionCard"
        style="@style/ChessMasterCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heroCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:fontFamily="serif"
                android:text="Choose Your Side"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- White Selection -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/whiteSelectionCard"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/glass_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/ic_white_king" />

                        <RadioButton
                            android:id="@+id/radioWhite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:fontFamily="serif"
                            android:text="White"
                            android:textColor="@color/md_theme_light_onSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Black Selection -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/blackSelectionCard"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/glass_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/ic_black_king" />

                        <RadioButton
                            android:id="@+id/radioBlack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="Black"
                            android:textColor="@color/md_theme_light_onSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Strength Selection Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/strengthCard"
        style="@style/ChessMasterCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/colorSelectionCard">

        <LinearLayout
            android:id="@+id/strengthContainer"
            style="@style/GlassSliderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"
                android:fontFamily="serif"
                android:text="AI Opponent Strength"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewStrengthValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:fontFamily="serif"
                android:text="Master Level: ~2200 Elo"
                android:textColor="@color/md_theme_light_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Modern Slider Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_slider_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="serif"
                    android:text="Beginner"
                    android:textColor="@color/md_theme_light_onSurfaceVariant"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/strengthSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="24"
                    android:progress="12"
                    android:progressBackgroundTint="@color/md_theme_light_outline"
                    android:progressTint="@color/md_theme_light_primary"
                    android:thumbTint="@color/md_theme_light_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="serif"
                    android:text="Grandmaster"
                    android:textColor="@color/md_theme_light_onSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Navigation Bar Spacing -->
    <Space
        android:id="@+id/navigationBarSpacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/startButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Start Game Button -->
        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/glass_button_bg"
            android:drawableStart="@android:drawable/ic_media_play"
            android:drawablePadding="12dp"
            android:elevation="8dp"
            android:fontFamily="serif"
            android:text="Begin Challenge"
            android:textColor="@color/md_theme_light_onPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:transitionName="start_button" />

        <!-- Modern Competitive Mode Button (Android 15) -->
        <Button
            android:id="@+id/modernCompetitiveModeButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/glass_button_bg"
            android:drawableStart="@android:drawable/ic_menu_compass"
            android:drawablePadding="12dp"
            android:elevation="6dp"
            android:fontFamily="serif"
            android:text="✨ Modern Mode (Android 15)"
            android:textColor="@color/md_theme_light_onPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:alpha="0.9" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>