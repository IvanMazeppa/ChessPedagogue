<?xml version="1.0" encoding="utf-8"?>
<!-- Exact glassmorphism specification from BUILDING-A-MODERN-CHESS-APP-UI.md -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- EXACT SPECIFICATION: 8% opacity background (GUARDRAILS requirement) -->
    <solid android:color="#14FFFFFF" />
    
    <!-- EXACT SPECIFICATION: 24dp corner radius -->
    <corners android:radius="24dp" />
    
    <!-- EXACT SPECIFICATION: 1dp border with 8% opacity -->
    <stroke 
        android:width="1dp"
        android:color="#14FFFFFF" />
        
</shape>