<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Teal indigo sweep from bottom-left to top-right -->
    <gradient
        android:startColor="@color/teal"
        android:endColor="@color/indigo_navy"
        android:angle="315"
    />

        <!-- Optional: round the outer corners a touch
         (looks nice on large screens / tablets) -->
    <corners android:radius="0dp" />
</shape>
