<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced glassmorphism button with drop shadow and subtle glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Drop Shadow Layer -->
    <item android:top="2dp" android:start="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#20000000" />
        </shape>
    </item>
    
    <!-- Main Glass Button Background -->
    <item android:bottom="2dp" android:end="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <!-- Semi-transparent blue with subtle glass effect -->
            <solid android:color="#1A1565C0" />
            <!-- Subtle border for definition -->
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    
    <!-- Inner Glow/Highlight -->
    <item android:bottom="3dp" android:end="3dp" android:top="1dp" android:start="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <!-- Subtle inner highlight -->
            <stroke android:width="1dp" android:color="#20FFFFFF" />
        </shape>
    </item>
    
</layer-list>