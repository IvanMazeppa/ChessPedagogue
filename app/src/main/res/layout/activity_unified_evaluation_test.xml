<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/enhanced_wood_background">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧪 Unified Evaluation System Tests"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/text_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎯 Ready to test UnifiedEvaluationSystem\n\nThis will verify:\n✅ No impossible evaluation swings\n✅ Consistent UCI perspective\n✅ UI integration\n✅ Performance"
        android:textSize="16sp"
        android:textColor="#4A4A4A"
        android:layout_marginBottom="24dp"
        android:background="@drawable/rounded_panel_background"
        android:padding="16dp" />

    <Button
        android:id="@+id/button_run_tests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧪 Run Unified Evaluation Tests"
        android:textSize="18sp"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp"
        android:padding="16dp" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/text_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Click 'Run Tests' to start evaluation system verification..."
            android:textSize="14sp"
            android:textColor="#333333"
            android:background="@color/white"
            android:padding="16dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

    </ScrollView>

</LinearLayout>