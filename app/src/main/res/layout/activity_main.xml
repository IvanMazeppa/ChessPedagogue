<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/enhanced_wood_background"
    tools:context=".MainActivity">

    <!-- Main content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main structure - EXACTLY like your original -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Enhanced Status Bar with Wood Theme but ORIGINAL spacing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_elevated"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_margin="8dp"
                android:elevation="4dp">

                <!-- Status Text with Beautiful Typography -->
                <TextView
                    android:id="@+id/statusTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="Ready to play"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <!-- Beautiful FloatingActionButtons with Wood Theme -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/gameAnalysisButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Game Analysis"
                    android:src="@drawable/ic_game_analysis"
                    app:backgroundTint="@color/chess_light_square"
                    app:elevation="6dp"
                    app:fabSize="mini"
                    app:rippleColor="@color/cream"
                    app:tint="@color/brown_dark" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/coachButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Chess Coach"
                    android:src="@drawable/ic_chess_puzzle"
                    app:backgroundTint="@color/bronze"
                    app:elevation="6dp"
                    app:fabSize="mini"
                    app:rippleColor="@color/gold"
                    app:tint="@color/brown_dark" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/speakButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Speak to Coach"
                    android:src="@drawable/ic_speak_to_coach"
                    app:backgroundTint="@color/warning_amber"
                    app:elevation="6dp"
                    app:fabSize="mini"
                    app:rippleColor="@color/cream"
                    app:tint="@color/brown_dark" />

            </LinearLayout>

            <!-- Challenge Container -->
            <FrameLayout
                android:id="@+id/challengeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- RESTORED: Chess Board with Perfect Space Utilization - EXACTLY like your original -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:padding="8dp">

                <!-- Chess Board - Perfectly Centered and Sized - EXACTLY like your original -->
                <com.example.chesspedagogue.ChessBoardView
                    android:id="@+id/chessBoardView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/evaluationBarView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5" />

                <!-- Evaluation Bar - Perfectly Aligned with Chess Board - EXACTLY like your original -->
                <com.example.chesspedagogue.EvaluationBarView
                    android:id="@+id/evaluationBarView"
                    android:layout_width="18dp"
                    android:layout_height="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/chessBoardView"
                    app:layout_constraintBottom_toBottomOf="@+id/chessBoardView"
                    android:layout_marginEnd="2dp"
                    android:background="@android:color/transparent" />

                <!-- Loading Indicator - Subtle Overlay -->
                <ProgressBar
                    android:id="@+id/evaluationProgressBar"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintStart_toStartOf="@+id/evaluationBarView"
                    app:layout_constraintEnd_toEndOf="@+id/evaluationBarView"
                    app:layout_constraintTop_toTopOf="@+id/evaluationBarView"
                    app:layout_constraintBottom_toBottomOf="@+id/evaluationBarView"
                    android:visibility="gone"
                    style="?android:attr/progressBarStyleSmall" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Enhanced Bottom Panel - Smart Coach/Move History Toggle -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/card_elevated"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Move History Panel (Default View) -->
                    <LinearLayout
                        android:id="@+id/moveHistoryPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Game Chronicle"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="serif"
                            android:layout_marginBottom="12dp"
                            android:gravity="center" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:scrollbars="vertical">

                            <LinearLayout
                                android:id="@+id/moveHistoryContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/moveHistoryTextView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="15sp"
                                    android:textColor="@color/text_primary"
                                    android:fontFamily="serif"
                                    android:lineSpacingExtra="3sp"
                                    android:padding="8dp"
                                    android:text="Game begins..." />
                            </LinearLayout>
                        </ScrollView>
                    </LinearLayout>

                    <!-- Coach Conversation Panel (Slides In When Active) -->
                    <LinearLayout
                        android:id="@+id/coachConversationPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone"
                        android:background="@color/coach_dialogue_bg">

                        <!-- Elegant Coach Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <!-- Coach Portrait -->
                            <ImageView
                                android:id="@+id/coachPortraitImageView"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/portrait_speaking_tal"
                                android:background="@drawable/enhanced_portrait_frame"
                                android:padding="2dp"
                                android:layout_marginEnd="12dp"
                                android:contentDescription="Current coach portrait" />

                            <!-- Coach Info -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/coachNameTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Coach Tal"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:fontFamily="serif" />

                                <TextView
                                    android:id="@+id/coachStatusTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ready to help"
                                    android:textSize="12sp"
                                    android:textStyle="italic"
                                    android:textColor="@color/text_accent"
                                    android:fontFamily="serif" />
                            </LinearLayout>

                            <!-- Action Buttons -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/askFollowUpButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_marginEnd="6dp"
                                    android:text="Ask"
                                    android:textSize="12sp"
                                    android:backgroundTint="@color/bronze"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp" />

                                <Button
                                    android:id="@+id/dismissCoachButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:text="×"
                                    android:textSize="14sp"
                                    android:backgroundTint="@color/brown_light"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Microphone Indicator (Compact) -->
                        <FrameLayout
                            android:id="@+id/micIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@android:drawable/ic_btn_speak_now"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:id="@+id/listeningText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Listening..."
                                    android:textStyle="italic"
                                    android:textColor="@color/text_primary"
                                    android:fontFamily="serif"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Scrollable Coach Message -->
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:scrollbars="vertical"
                            android:fadeScrollbars="false">

                            <TextView
                                android:id="@+id/coachMessageText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:lineSpacingExtra="3sp"
                                android:padding="8dp"
                                android:text="Ready to discuss your game!" />
                        </ScrollView>
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Chat panel (keeping your existing implementation) -->
        <include
            android:id="@+id/chatPanel"
            layout="@layout/chat_panel_layout"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_gravity="bottom"
            android:visibility="gone" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>