<?xml version="1.0" encoding="utf-8"?>
<!-- Glass background for strength slider container -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base glass surface -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/glass_surface_variant" />
        </shape>
    </item>
    
    <!-- Glass border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke 
                android:width="1dp" 
                android:color="@color/glass_outline" />
        </shape>
    </item>
    
    <!-- Top highlight for glass reflection -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke 
                android:width="0.5dp" 
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>