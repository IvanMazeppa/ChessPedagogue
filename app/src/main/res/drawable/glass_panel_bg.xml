<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass panel background for Android 15 glassmorphism -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base translucent background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/glass_background" />
        </shape>
    </item>
    
    <!-- Subtle border for glass edge effect -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke 
                android:width="1dp" 
                android:color="@color/glass_outline" />
        </shape>
    </item>
    
    <!-- Inner blue-teal highlight for glass reflection -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <stroke 
                android:width="0.5dp" 
                android:color="#3080B0D0" />
        </shape>
    </item>
</layer-list>