<?xml version="1.0" encoding="utf-8"?>
<!-- Speech Transcription Overlay with Premium Glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Animated Outer Glow (for active speech recognition) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="100dp"
                android:centerX="0.7"
                android:centerY="0.4"
                android:startColor="#50FF6B35"
                android:centerColor="#30456789"
                android:endColor="#00000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    
    <!-- Main Speech Panel -->
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="145"
                android:startColor="@color/glass_overlay_speech_enhanced"
                android:centerColor="#A0123456"
                android:endColor="@color/glass_surface_premium" />
            <corners android:radius="15dp" />
            <stroke
                android:width="1.5dp"
                android:color="#60FFFFFF" />
        </shape>
    </item>
    
</layer-list>