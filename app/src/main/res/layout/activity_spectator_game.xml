<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2C2C2E"
    android:fitsSystemWindows="true"
    tools:context=".SpectatorGameActivity">

    <!-- Player Info Container - Fixed at top -->
    <LinearLayout
        android:id="@+id/playerInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- White Player -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/whitePlayerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="⚪ Mikhail Tal"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:background="#FFFFFF"
                android:gravity="center" />

        </androidx.cardview.widget.CardView>

        <!-- Evaluation Bar -->
        <com.example.chesspedagogue.EvaluationBarView
            android:id="@+id/evaluationBarView"
            android:layout_width="18dp"
            android:layout_height="60dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <!-- Black Player -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/blackPlayerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="⚫ Bobby Fischer"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="#2C2C2E"
                android:gravity="center" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Chess Board - Constrained properly to avoid menu overlap -->
    <com.example.chesspedagogue.ChessBoardView
        android:id="@+id/chessBoardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/playerInfoContainer"
        app:layout_constraintBottom_toTopOf="@id/controlsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1" />
    <!-- Enhanced Controls Container with User Comment Button -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/infoContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/pauseResumeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="⏸️ Pause"
            android:backgroundTint="#FF9800"
            android:textSize="12sp" />

        <Button
            android:id="@+id/speedControlButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="⏱️ Normal"
            android:backgroundTint="#2196F3"
            android:textSize="12sp" />

        <!-- NEW: User Comment Button -->
        <Button
            android:id="@+id/userCommentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="🎤 Comment"
            android:backgroundTint="#4CAF50"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/thinkingProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>


    <!-- Game Info Container - Fixed at bottom -->
    <LinearLayout
        android:id="@+id/infoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="120dp"
        app:layout_constraintHeight_max="180dp">

        <!-- Move History -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/moveHistoryTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="🎭 Epic battle begins..."
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="@android:color/black" />

            </ScrollView>
        </androidx.cardview.widget.CardView>

        <!-- AI Dialogue Card - NEW! -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dialogueCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#E8F5E8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Speaker indicator -->
                <TextView
                    android:id="@+id/currentSpeakerTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💬 AI Masters Speaking"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:layout_marginBottom="8dp" />

                <!-- Dialogue content -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/dialogueTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎙️ Welcome to AI vs AI mode! Watch as the chess masters discuss their moves in real-time!"
                        android:textSize="14sp"
                        android:textColor="@android:color/black"
                        android:lineSpacingExtra="2dp" />

                </ScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>