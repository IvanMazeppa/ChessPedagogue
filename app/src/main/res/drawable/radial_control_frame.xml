<?xml version="1.0" encoding="utf-8"?>
<!-- Radial control frame with neon orange border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Outer glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="3dp" android:color="#30FF6600" />
        </shape>
    </item>
    
    <!-- Main frame background -->
    <item android:top="4dp" android:bottom="4dp" android:start="4dp" android:end="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <!-- Dark semi-transparent background -->
            <solid android:color="#0F1565C0" />
            <!-- Bright orange neon border -->
            <stroke android:width="2dp" android:color="#FFFF6600" />
        </shape>
    </item>
    
    <!-- Inner subtle highlight -->
    <item android:top="6dp" android:bottom="6dp" android:start="6dp" android:end="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#40FF8833" />
        </shape>
    </item>
    
</layer-list>