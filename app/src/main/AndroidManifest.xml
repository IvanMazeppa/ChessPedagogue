<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_chess_pedagogue_logo"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_chess_pedagogue_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChessPedagogue"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="35">

        <!-- SplashActivity with modern glassmorphic theme -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ChessPedagogue.Splash"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity with edge-to-edge support -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChessPedagogue"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- Game Analysis Activity -->
        <activity
            android:name=".GameAnalysisActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Chess Conversation Activity -->
        <activity
            android:name=".ChessConversationActivity"
            android:label="Chess Coach"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <!-- Saved Games Activity -->
        <activity
            android:name=".SavedGamesActivity"
            android:label="Saved Games"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:label="Settings"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <!-- SimpleRecord Service -->
        <service
            android:name=".SimpleRecordService"
            android:enabled="true"
            android:exported="false" />

        <!-- Always-Listening Wake Word Service -->
        <service
            android:name=".AlwaysListeningService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Chess Master Selection Activity -->
        <activity
            android:name=".ChessMasterSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.ChessPedagogue.NoActionBar" />
        <activity
            android:name=".SpectatorGameActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="Spectator Mode"/>

        <!-- Competitive Mode Activity with glassmorphism -->
        <activity
            android:name=".CompetitiveModeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="🏆 Competitive Mode"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <!-- Modern Competitive Mode Activity - Android 15 Glassmorphism -->
        <activity
            android:name=".ModernCompetitiveModeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="✨ Modern Competitive Mode"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
            <meta-data
                android:name="android:windowContentTransitions"
                android:value="true" />
        </activity>
        
        <!-- Responses API Test Activity -->
        <activity
            android:name=".ResponsesAPITestActivity"
            android:exported="false"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="Responses API Test" />

        <!-- Unified Evaluation Test Activity -->
        <activity
            android:name=".UnifiedEvaluationTestActivity"
            android:exported="false"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="🧪 Evaluation System Tests"
            android:parentActivityName=".SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".SettingsActivity" />
        </activity>

        <!-- Analytics Activity -->
        <activity
            android:name=".AnalyticsActivity"
            android:exported="false"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="🎭 Personality Analytics"
            android:parentActivityName=".SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".SettingsActivity" />
        </activity>

        <!-- User Profile Activity -->
        <activity
            android:name=".UserProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="👤 Chess Profile"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <!-- Tactical Puzzle Activity -->
        <activity
            android:name=".TacticalPuzzleActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChessPedagogue.NoActionBar"
            android:label="🧩 Tactical Puzzles"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

    </application>

</manifest>