<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced glassmorphism button pressed state -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Reduced Drop Shadow when pressed -->
    <item android:top="1dp" android:start="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#30000000" />
        </shape>
    </item>
    
    <!-- Main Glass Button Background - Slightly more opaque when pressed -->
    <item android:bottom="1dp" android:end="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <!-- More visible when pressed -->
            <solid android:color="#2A1565C0" />
            <!-- Brighter border when pressed -->
            <stroke android:width="1dp" android:color="#60FFFFFF" />
        </shape>
    </item>
    
    <!-- Inner Glow/Highlight -->
    <item android:bottom="2dp" android:end="2dp" android:top="1dp" android:start="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <!-- Brighter inner highlight when pressed -->
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    
</layer-list>