<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wood_background"
    tools:context=".MainActivity">

    <!-- Main content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main structure -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Elegant Status Bar with Wood Theme -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/wood_panel_bg"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_margin="8dp">

                <!-- Status Text with Beautiful Typography -->
                <TextView
                    android:id="@+id/statusTextView"
                    style="@style/WoodBodyText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Welcome to Chess Pedagogue!"
                    android:textColor="@color/text_on_light"
                    android:textSize="16sp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="serif" />
               <!--  <Button
                    android:id="@+id/btnCoachMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coach Match: Tal vs Fischer"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/> -->



                <!-- Beautiful Action Buttons with Wood Styling -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/gameAnalysisButton"
                    style="@style/WoodFAB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Analyze Position"
                    android:src="@android:drawable/ic_menu_search"
                    app:backgroundTint="@color/gold"
                    app:tint="@color/brown_dark"
                    app:fabSize="mini" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/coachButton"
                    style="@style/WoodFAB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Ask Coach"
                    android:src="@android:drawable/ic_dialog_info"
                    app:backgroundTint="@color/bronze"
                    app:tint="@color/cream"
                    app:fabSize="mini" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/speakButton"
                    style="@style/WoodFAB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Speak to Coach"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:backgroundTint="@color/warning_amber"
                    app:tint="@color/brown_dark"
                    app:fabSize="mini" />
            </LinearLayout>

            <!-- Challenge Container -->
            <FrameLayout
                android:id="@+id/challengeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Chess Board (Keep your beautiful wood board!) -->
            <com.example.chesspedagogue.ChessBoardView
                android:id="@+id/chessBoardView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3" />

            <!-- Enhanced Bottom Panel - Smart Coach/Move History Toggle -->
            <!-- THIS IS WHERE IT BELONGS - INSIDE THE LINEARLAYOUT! -->
            <androidx.cardview.widget.CardView
                style="@style/WoodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/parchment"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Move History Panel (Default View) -->
                    <LinearLayout
                        android:id="@+id/moveHistoryPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Game Chronicle"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_on_light"
                            android:fontFamily="serif"
                            android:layout_marginBottom="12dp"
                            android:gravity="center" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:scrollbars="vertical">

                            <LinearLayout
                                android:id="@+id/moveHistoryContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/moveHistoryTextView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="15sp"
                                    android:textColor="@color/text_on_light"
                                    android:fontFamily="serif"
                                    android:lineSpacingExtra="3sp"
                                    android:padding="8dp"
                                    android:text="Game begins..." />
                            </LinearLayout>
                        </ScrollView>
                    </LinearLayout>

                    <!-- Coach Conversation Panel (Slides In When Active) -->
                    <LinearLayout
                        android:id="@+id/coachConversationPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone"
                        android:background="@color/ivory">

                        <!-- Elegant Coach Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <!-- Coach Portrait -->
                            <ImageView
                                android:id="@+id/coachPortraitImageView"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/portrait_speaking_tal"
                                android:background="@drawable/portrait_frame"
                                android:padding="2dp"
                                android:layout_marginEnd="12dp"
                                android:contentDescription="Current coach portrait" />

                            <!-- Coach Info -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/coachNameTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Coach Tal"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_on_light"
                                    android:fontFamily="serif" />

                                <TextView
                                    android:id="@+id/coachStatusTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ready to help"
                                    android:textSize="12sp"
                                    android:textStyle="italic"
                                    android:textColor="@color/bronze"
                                    android:fontFamily="serif" />
                            </LinearLayout>

                            <!-- Action Buttons -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/askFollowUpButton"
                                    style="@style/WoodButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_marginEnd="6dp"
                                    android:text="Ask"
                                    android:textSize="12sp"
                                    android:backgroundTint="@color/bronze"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp" />

                                <Button
                                    android:id="@+id/dismissCoachButton"
                                    style="@style/WoodButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:text="×"
                                    android:textSize="14sp"
                                    android:backgroundTint="@color/brown_light"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Microphone Indicator (Compact) -->
                        <FrameLayout
                            android:id="@+id/micIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@android:drawable/ic_btn_speak_now"
                                    app:tint="@color/warning_amber"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:id="@+id/listeningText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Listening..."
                                    android:textStyle="italic"
                                    android:textColor="@color/text_on_light"
                                    android:fontFamily="serif"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Scrollable Coach Message -->
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:scrollbars="vertical"
                            android:fadeScrollbars="false">

                            <TextView
                                android:id="@+id/coachMessageText"
                                style="@style/WoodBodyText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:lineSpacingExtra="3sp"
                                android:padding="8dp"
                                android:text="Ready to discuss your game!" />
                        </ScrollView>
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Chat panel (keeping your existing implementation) -->
        <include
            android:id="@+id/chatPanel"
            layout="@layout/chat_panel_layout"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_gravity="bottom"
            android:visibility="gone" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>