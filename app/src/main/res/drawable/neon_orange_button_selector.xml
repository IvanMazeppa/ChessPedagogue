<?xml version="1.0" encoding="utf-8"?>
<!-- Neon orange button state selector -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Outer glow - more intense when pressed -->
            <item android:top="1dp" android:bottom="1dp" android:start="1dp" android:end="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <stroke android:width="3dp" android:color="#60FF6600" />
                </shape>
            </item>
            
            <!-- Main button background - brighter when pressed -->
            <item android:top="4dp" android:bottom="4dp" android:start="4dp" android:end="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#2A1565C0" />
                    <stroke android:width="2dp" android:color="#FFFF8833" />
                </shape>
            </item>
            
            <!-- Inner highlight -->
            <item android:top="6dp" android:bottom="6dp" android:start="6dp" android:end="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="#CCFFAA55" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Default State -->
    <item>
        <layer-list>
            <!-- Outer glow -->
            <item android:top="2dp" android:bottom="2dp" android:start="2dp" android:end="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#40FF6600" />
                </shape>
            </item>
            
            <!-- Main button background -->
            <item android:top="4dp" android:bottom="4dp" android:start="4dp" android:end="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#1A1565C0" />
                    <stroke android:width="2dp" android:color="#FFFF6600" />
                </shape>
            </item>
            
            <!-- Inner highlight -->
            <item android:top="6dp" android:bottom="6dp" android:start="6dp" android:end="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="#80FF8833" />
                </shape>
            </item>
        </layer-list>
    </item>
    
</selector>