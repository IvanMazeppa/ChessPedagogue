<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced glassmorphism panel with subtle grid lines for button separation -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Main Panel Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <!-- Semi-transparent blue background -->
            <solid android:color="#0F1565C0" />
            <!-- Subtle outer border -->
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
    
    <!-- Inner highlight for depth -->
    <item android:top="1dp" android:start="1dp" android:end="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <!-- Inner glow effect -->
            <stroke android:width="1dp" android:color="#15FFFFFF" />
        </shape>
    </item>
    
</layer-list>