<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wood_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Elegant Header -->
            <androidx.cardview.widget.CardView
                style="@style/WoodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/parchment"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/portrait_speaking_tal"
                        android:background="@drawable/portrait_frame"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        style="@style/WoodHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prepare for Battle"
                        android:textSize="24sp"
                        android:textColor="@color/text_on_light"
                        android:fontFamily="serif"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        style="@style/WoodSubheading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configure your chess challenge"
                        android:textColor="@color/bronze"
                        android:fontFamily="serif" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Side Selection Card -->
            <androidx.cardview.widget.CardView
                style="@style/WoodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ivory"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose Your Side"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_light"
                        android:fontFamily="serif"
                        android:layout_marginBottom="16dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="@drawable/wood_panel_bg"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_white_king"
                                android:layout_marginBottom="8dp" />

                            <RadioButton
                                android:id="@+id/radioWhite"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="White"
                                android:checked="true"
                                android:textColor="@color/text_on_light"
                                android:fontFamily="serif"
                                android:buttonTint="@color/gold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="@drawable/wood_panel_bg"
                            android:layout_marginStart="8dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_black_king"
                                android:layout_marginBottom="8dp" />

                            <RadioButton
                                android:id="@+id/radioBlack"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Black"
                                android:textColor="@color/text_on_light"
                                android:fontFamily="serif"
                                android:buttonTint="@color/gold" />
                        </LinearLayout>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Engine Strength Card -->
            <androidx.cardview.widget.CardView
                style="@style/WoodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/ivory"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opponent Strength"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_light"
                        android:fontFamily="serif"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/textViewStrengthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Engine Strength: ~1750 Elo (Level 10)"
                        android:textSize="16sp"
                        android:textColor="@color/bronze"
                        android:fontFamily="serif"
                        android:layout_marginBottom="16dp" />

                    <!-- Enhanced Slider with Visual Indicators -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Beginner"
                            android:textSize="12sp"
                            android:textColor="@color/text_on_light"
                            android:layout_marginEnd="8dp" />

                        <SeekBar
                            android:id="@+id/seekBarStrength"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="20"
                            android:progress="10"
                            android:progressTint="@color/gold"
                            android:thumbTint="@color/bronze" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:text="Super GM"
                            android:textColor="@color/text_on_light"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Strength Description -->
                    <TextView
                        android:id="@+id/strengthDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A balanced challenge for intermediate players"
                        android:textSize="14sp"
                        android:textStyle="italic"
                        android:textColor="@color/text_on_light"
                        android:layout_marginTop="12dp"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Start Game Button -->
            <Button
                android:id="@+id/buttonStartGame"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Begin the Challenge"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/brown_dark"
                android:fontFamily="serif"
                android:backgroundTint="@color/gold"
                android:drawableStart="@android:drawable/ic_media_play"
                android:drawablePadding="8dp"
                android:elevation="6dp" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>