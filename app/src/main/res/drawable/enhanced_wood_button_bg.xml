<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/brown_dark"
                android:endColor="@color/brown_deep"
                android:angle="135" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/gold_dark" />
            <padding android:left="4dp" android:top="4dp"
                android:right="4dp" android:bottom="4dp" />
        </shape>
    </item>

    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/brown_wood"
                android:endColor="@color/brown_medium"
                android:angle="135" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/gold" />
            <padding android:left="4dp" android:top="4dp"
                android:right="4dp" android:bottom="4dp" />
        </shape>
    </item>

    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/brown_wood"
                android:endColor="@color/brown_medium"
                android:angle="135" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/gold" />
            <padding android:left="4dp" android:top="4dp"
                android:right="4dp" android:bottom="4dp" />
        </shape>
    </item>
</selector>