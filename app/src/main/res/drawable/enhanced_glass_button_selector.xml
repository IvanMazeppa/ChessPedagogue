<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced glassmorphism button state selector -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Reduced Drop Shadow when pressed -->
            <item android:top="1dp" android:start="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#30000000" />
                </shape>
            </item>
            
            <!-- Main Glass Button Background - More opaque when pressed -->
            <item android:bottom="1dp" android:end="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#2A1565C0" />
                    <stroke android:width="1dp" android:color="#60FFFFFF" />
                </shape>
            </item>
            
            <!-- Inner Glow -->
            <item android:bottom="2dp" android:end="2dp" android:top="1dp" android:start="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="11dp" />
                    <stroke android:width="1dp" android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Default State -->
    <item>
        <layer-list>
            <!-- Drop Shadow -->
            <item android:top="2dp" android:start="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#20000000" />
                </shape>
            </item>
            
            <!-- Main Glass Button Background -->
            <item android:bottom="2dp" android:end="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#1A1565C0" />
                    <stroke android:width="1dp" android:color="#40FFFFFF" />
                </shape>
            </item>
            
            <!-- Inner Glow -->
            <item android:bottom="3dp" android:end="3dp" android:top="1dp" android:start="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="11dp" />
                    <stroke android:width="1dp" android:color="#20FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    
</selector>