<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_android_icon_main"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_android_icon_main_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChessPedagogue"
        tools:targetApi="33">

        <!-- SplashActivity will be the launch activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- Game Analysis Activity -->
        <activity
            android:name=".GameAnalysisActivity"
            android:exported="false" />

        <!-- Chess Conversation Activity -->
        <activity
            android:name=".ChessConversationActivity"
            android:label="Chess Coach"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <!-- Saved Games Activity -->
        <activity
            android:name=".SavedGamesActivity"
            android:label="Saved Games"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:label="Settings"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>

        <!-- SimpleRecord Service -->
        <service
            android:name=".SimpleRecordService"
            android:enabled="true"
            android:exported="false" />

        <!-- Always-Listening Wake Word Service -->
        <service
            android:name=".AlwaysListeningService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Chess Master Selection Activity -->
        <activity
            android:name=".ChessMasterSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.ChessPedagogue.NoActionBar" />
        <activity
            android:name=".SpectatorGameActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="Spectator Mode"/>

        <!-- Competitive Mode Activity -->
        <activity
            android:name=".CompetitiveModeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="🏆 Competitive Mode"
            android:parentActivityName=".MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>
        
        <!-- Responses API Test Activity -->
        <activity
            android:name=".ResponsesAPITestActivity"
            android:exported="false"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="Responses API Test" />

        <!-- Analytics Activity -->
        <activity
            android:name=".AnalyticsActivity"
            android:exported="false"
            android:theme="@style/Theme.ChessPedagogue"
            android:label="🎭 Personality Analytics"
            android:parentActivityName=".SettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".SettingsActivity" />
        </activity>

    </application>

</manifest>