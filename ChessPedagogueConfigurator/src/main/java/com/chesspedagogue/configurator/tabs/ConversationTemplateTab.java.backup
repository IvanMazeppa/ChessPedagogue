        logger.info("📄 Creating new conversation template...");
        // Implementation for creating new template
    }
    
    private void duplicateCurrentTemplate() {
        logger.info("📋 Duplicating current template...");
        // Implementation for duplicating template
    }
    
    private void deleteCurrentTemplate() {
        logger.info("🗑️ Deleting current template...");
        // Implementation for deleting template
    }
    
    private void runTemplateSimulation() {
        logger.info("🧪 Running template simulation...");
        simulationProgress.setVisible(true);
        simulationProgress.setProgress(0);
        
        // TODO: Implement actual simulation
        
        simulationResults.setText("Simulation: 6 turns completed, average 2.8s intervals, 87% engagement rate");
    }
    
    private void saveCurrentTemplate() {
        logger.info("💾 Saving current template...");
        // Implementation for saving template
    }
    
    private void applyTemplateToGame() {
        logger.info("🚀 Applying template to game...");
        // Implementation for applying to game
    }
    
    private void resetCurrentTemplate() {
        logger.info("🔄 Resetting current template...");
        loadSelectedTemplate();
    }
    
    private void exportTemplate() {
        logger.info("📤 Exporting template...");
        // Implementation for exporting template
    }
    
    // Public methods for external access
    public Tab getTab() {
        return tab;
    }
    
    public void refresh() {
        loadTemplates();
    }
    
    public void runTemplateTest() {
        runTemplateSimulation();
    }
}