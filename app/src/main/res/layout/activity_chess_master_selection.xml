                        android:layout_marginTop="12dp" />

                    <RadioButton
                        android:id="@+id/radioKarpov"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Coach Karpov"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
