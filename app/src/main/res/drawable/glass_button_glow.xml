<?xml version="1.0" encoding="utf-8"?>
<!-- Premium glassmorphic button with glowing edges and press states -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Pressed state with enhanced glow -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Enhanced outer glow when pressed -->
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#3080C0FF" />
                </shape>
            </item>
            
            <!-- Pressed surface with higher opacity -->
            <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#6060A0C0" />
                    <stroke android:width="1dp" android:color="#80A0C0FF" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Default state -->
    <item>
        <layer-list>
            <!-- Outer glow effect -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#1A60A0FF" />
                </shape>
            </item>
            
            <!-- Main button surface -->
            <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#40506080" />
                    <stroke android:width="1dp" android:color="#6080A0C0" />
                </shape>
            </item>
            
            <!-- Inner highlight -->
            <item android:top="5dp" android:left="5dp" android:right="5dp" android:bottom="7dp">
                <shape android:shape="rectangle">
                    <corners android:radius="9dp" />
                    <stroke android:width="0.5dp" android:color="#4080C0FF" />
                </shape>
            </item>
        </layer-list>
    </item>
    
</selector>