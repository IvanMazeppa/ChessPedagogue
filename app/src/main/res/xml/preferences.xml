<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="AI Coach Settings">
        <ListPreference
            android:key="voice_preference"
            android:title="Coach Voice"
            android:summary="Select the voice for your chess coach"
            android:entries="@array/voice_entries"
            android:entryValues="@array/voice_values"
            android:defaultValue="grandmaster"/>

        <ListPreference
            android:key="model_preference"
            android:title="AI Model"
            android:summary="Select which AI model to use (better models may cost more)"
            android:entries="@array/model_entries"
            android:entryValues="@array/model_values"
            android:defaultValue="gpt-4.1-mini"/>
    </PreferenceCategory>

    <PreferenceCategory android:title="General Settings">
        <SwitchPreference
            android:key="auto_commentary"
            android:title="Auto Commentary"
            android:summary="Enable/disable automatic commentary after moves"
            android:defaultValue="true"/>

        <SwitchPreference
            android:key="use_tts"
            android:title="Text-to-Speech"
            android:summary="Enable voice output for the coach"
            android:defaultValue="true"/>
    </PreferenceCategory>

    <PreferenceCategory android:title="Visual Effects">
        <SwitchPreference
            android:key="neon_mode_enabled"
            android:title="Neon Chessboard"
            android:summary="Enable futuristic neon glow effects on the chessboard"
            android:defaultValue="false"/>

        <SeekBarPreference
            android:key="neon_glow_intensity"
            android:title="Neon Glow Intensity"
            android:summary="Adjust the brightness of neon effects"
            android:dependency="neon_mode_enabled"
            android:defaultValue="80"
            android:max="100"/>

        <SwitchPreference
            android:key="neon_pulsing_enabled"
            android:title="Neon Pulsing"
            android:summary="Enable rhythmic pulsing of neon effects"
            android:dependency="neon_mode_enabled"
            android:defaultValue="false"/>

        <ListPreference
            android:key="neon_color_theme"
            android:title="Neon Color Theme"
            android:summary="Choose color scheme for neon effects"
            android:dependency="neon_mode_enabled"
            android:entries="@array/neon_theme_entries"
            android:entryValues="@array/neon_theme_values"
            android:defaultValue="electric_blue_green"/>
    </PreferenceCategory>
</PreferenceScreen>