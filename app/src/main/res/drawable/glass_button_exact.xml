<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced glassmorphism button for better visual distinction -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Enhanced background: 12% opacity for better visibility -->
    <solid android:color="#1FFFFFFF" />
    
    <!-- Consistent 8dp corner radius for button grid -->
    <corners android:radius="8dp" />
    
    <!-- Enhanced border: 20% opacity for better visual separation -->
    <stroke 
        android:width="1dp"
        android:color="#33FFFFFF" />
        
</shape>