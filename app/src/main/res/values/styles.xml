<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/brown_dark</item>
        <item name="colorPrimaryDark">@color/brown_dark</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:windowBackground">@drawable/wood_background</item>
        <item name="android:textColorPrimary">@color/cream</item>
        <item name="android:textColorSecondary">@color/cream_light</item>
    </style>

    <!-- Wood Button Style -->
    <style name="WoodButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/wood_button_bg</item>
        <item name="android:textColor">@color/cream</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Wood Card Style -->
    <style name="WoodCard" parent="CardView">
        <item name="cardBackgroundColor">@color/parchment</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- Coach Portrait Style -->
    <style name="CoachPortrait">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:background">@drawable/portrait_frame</item>
        <item name="android:padding">4dp</item>
    </style>

    <!-- Heading Text Styles -->
    <style name="WoodHeading" parent="TextAppearance.AppCompat.Large">
        <item name="android:textColor">@color/cream</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:shadowColor">@color/brown_dark</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <style name="WoodSubheading" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@color/cream_light</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="WoodBodyText" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/text_on_light</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <!-- Switch Style -->
    <style name="WoodSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumbTint">@color/gold</item>
        <item name="android:trackTint">@color/brown_light</item>
        <item name="android:textColor">@color/cream</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <!-- Radio Button Style -->
    <style name="WoodRadio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:buttonTint">@color/gold</item>
        <item name="android:textColor">@color/cream</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- SeekBar Style -->
    <style name="WoodSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:thumbTint">@color/gold</item>
        <item name="android:progressTint">@color/gold</item>
        <item name="android:progressBackgroundTint">@color/brown_light</item>
    </style>

    <!-- Toolbar Style -->
    <style name="WoodToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/brown_dark</item>
        <item name="titleTextColor">@color/cream</item>
        <item name="android:elevation">8dp</item>
    </style>

    <!-- Floating Action Button Style -->
    <style name="WoodFAB" parent="Widget.Design.FloatingActionButton">
        <item name="backgroundTint">@color/gold</item>
        <item name="tint">@color/brown_dark</item>
        <item name="android:elevation">6dp</item>
    </style>
</resources>