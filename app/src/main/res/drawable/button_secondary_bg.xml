<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/cream"
                android:endColor="@color/parchment"
                android:angle="135" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="@color/bronze_dark" />
        </shape>
    </item>

    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/cream_warm"
                android:endColor="@color/parchment_light"
                android:angle="135" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/bronze" />
        </shape>
    </item>
</selector>