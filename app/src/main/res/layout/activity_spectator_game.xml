<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".SpectatorGameActivity">

    <!-- Compact Player Names Bar -->
    <LinearLayout
        android:id="@+id/playerInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#2A2A2A">

        <!-- White Player - Compact -->
        <TextView
            android:id="@+id/whitePlayerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚪ Mikhail Tal"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="start"
            android:padding="8dp"
            android:background="#4CAF50"
            android:layout_marginEnd="2dp" />

        <!-- Black Player - Compact -->
        <TextView
            android:id="@+id/blackPlayerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚫ Bobby Fischer"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="end"
            android:padding="8dp"
            android:background="#FF5722"
            android:layout_marginStart="2dp" />

    </LinearLayout>

    <!-- Full-Width Chess Board Area (Like Main Game) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="0dp">

        <!-- Chess Board - Flush with Both Edges -->
        <com.example.chesspedagogue.ChessBoardView
            android:id="@+id/chessBoardView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/evaluationBarView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <!-- Evaluation Bar - Flush with Left Edge -->
        <com.example.chesspedagogue.EvaluationBarView
            android:id="@+id/evaluationBarView"
            android:layout_width="18dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/chessBoardView"
            app:layout_constraintBottom_toBottomOf="@+id/chessBoardView"
            android:layout_marginEnd="4dp"
            android:background="@android:color/transparent" />

        <!-- Thinking Indicator -->
        <ProgressBar
            android:id="@+id/thinkingProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminateTint="#FF9800"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/chessBoardView"
            app:layout_constraintEnd_toEndOf="@+id/chessBoardView"
            app:layout_constraintTop_toTopOf="@+id/chessBoardView"
            app:layout_constraintBottom_toBottomOf="@+id/chessBoardView" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Game Panels Under Board -->
    <LinearLayout
        android:id="@+id/gamePanelsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Move History Panel -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#F5F5F5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 Game Moves"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/moveHistoryTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎭 Epic battle begins..."
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textColor="#424242"
                        android:lineSpacingExtra="1dp" />

                </ScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- AI Dialogue Panel -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dialogueCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#E8F8E8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Enhanced Speaker Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/currentSpeakerTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💬 Masters Conversing"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />

                    <!-- Live indicator -->
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/pulse"
                        android:backgroundTint="#4CAF50" />

                </LinearLayout>

                <!-- Dialogue Content -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/dialogueTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎙️ Welcome to the AI Masters arena! Watch as chess legends come alive to discuss strategy and share their insights in real-time!"
                        android:textSize="13sp"
                        android:textColor="#1B5E20"
                        android:lineSpacingExtra="3dp"
                        android:padding="4dp" />

                </ScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Enhanced Controls - Two Row Layout -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#2A2A2A">

        <!-- Primary Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/pauseResumeButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="⏸️ Pause"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/speedControlButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="⏱️ Normal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/ttsToggleButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🔊 TTS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#9C27B0"
                android:textColor="#FFFFFF"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

        <!-- Secondary Controls Row - Enhanced Comment Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Main Comment Button with Quick Actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/rounded_panel_background"
                android:backgroundTint="#4CAF50"
                android:padding="2dp">

                <!-- Quick Voice Button -->
                <Button
                    android:id="@+id/quickVoiceButton"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:text="🎤"
                    android:textSize="16sp"
                    android:backgroundTint="#388E3C"
                    android:textColor="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button" />

                <!-- Main Comment Button -->
                <Button
                    android:id="@+id/userCommentButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:backgroundTint="@android:color/transparent"
                    android:text="Ask the Masters"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Quick Type Button -->
                <Button
                    android:id="@+id/quickTypeButton"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:text="⌨️"
                    android:textSize="14sp"
                    android:backgroundTint="#388E3C"
                    android:textColor="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>