<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced Button with Micro-Interaction Glow -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_accent">
    
    <item android:id="@android:id/background">
        <layer-list>
            
            <!-- Subtle Button Glow -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="40dp"
                        android:centerX="0.5"
                        android:centerY="0.5"
                        android:startColor="#40456789"
                        android:endColor="#00000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            
            <!-- Main Button Surface -->
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="@color/glass_button_primary"
                        android:endColor="@color/glass_surface_premium" />
                    <corners android:radius="11dp" />
                    <stroke
                        android:width="0.5dp"
                        android:color="#50FFFFFF" />
                </shape>
            </item>
            
        </layer-list>
    </item>
    
</ripple>