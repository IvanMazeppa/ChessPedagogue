<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/gold_dark"
                android:endColor="@color/bronze_dark"
                android:angle="135" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/brown_dark" />
        </shape>
    </item>

    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/gold"
                android:endColor="@color/bronze"
                android:angle="135" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/brown_medium" />
        </shape>
    </item>
</selector>