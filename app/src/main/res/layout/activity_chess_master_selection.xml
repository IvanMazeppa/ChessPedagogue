                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="The Berlin Wall"
                                android:textStyle="italic" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Master of positional play and endgame technique. Kramnik's approach focuses on solid structures, subtle advantages, and technical precision."
                        android:layout_marginTop="12dp" />

                    <RadioButton
                        android:id="@+id/radioKramnik"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Coach Kramnik"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

