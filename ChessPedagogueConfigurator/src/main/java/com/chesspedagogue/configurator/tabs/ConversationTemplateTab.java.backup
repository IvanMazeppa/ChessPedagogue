package com.chesspedagogue.configurator.tabs;

import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.control.*;
import javafx.scene.layout.*;
import javafx.scene.paint.Color;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;
import com.chesspedagogue.configurator.managers.ConfigurationManager;
import com.chesspedagogue.configurator.models.ConversationTemplate;
import com.chesspedagogue.configurator.utils.SliderWithLabel;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * 🎭 Conversation Template Designer Tab
 * 
 * Allows users to design and test conversation flow templates with visual controls
 * for turn counts, response rates, and timing intervals.
 */
public class ConversationTemplateTab {
    
    private static final Logger logger = LoggerFactory.getLogger(ConversationTemplateTab.class);
    private final ConfigurationManager configManager;
    private Tab tab;
    
    // UI Components
    private ComboBox<String> templateSelector;
    private TextField templateNameField;
    private TextArea templateDescriptionArea;
    
    // Opening Conversation Controls
    private SliderWithLabel openingMinTurns;
    private SliderWithLabel openingMaxTurns;
    private SliderWithLabel openingResponseRate;
    private SliderWithLabel openingInterval;
    
    // Position Analysis Controls
    private SliderWithLabel analysisMinTurns;
    private SliderWithLabel analysisMaxTurns;
    private SliderWithLabel analysisResponseRate;
    private SliderWithLabel analysisInterval;
    
    // Quick Reaction Controls
    private SliderWithLabel reactionMinTurns;
    private SliderWithLabel reactionMaxTurns;
    private SliderWithLabel reactionResponseRate;
    private SliderWithLabel reactionInterval;
    
    // Endgame Controls
    private SliderWithLabel endgameMinTurns;
    private SliderWithLabel endgameMaxTurns;
    private SliderWithLabel endgameResponseRate;
    private SliderWithLabel endgameInterval;
    
    // Preview and Testing
    private TextArea previewArea;
    private ProgressBar simulationProgress;
    private Label simulationResults;
    
    public ConversationTemplateTab(ConfigurationManager configManager) {
        this.configManager = configManager;
        createTab();
    }
    
    private void createTab() {
        tab = new Tab("🎭 Conversation Templates");
        tab.setClosable(false);
        
        ScrollPane scrollPane = new ScrollPane();
        scrollPane.setFitToWidth(true);
        scrollPane.setVbarPolicy(ScrollPane.ScrollBarPolicy.AS_NEEDED);
        
        VBox mainContent = new VBox(15);
        mainContent.setPadding(new Insets(20));
        mainContent.setMaxWidth(1000);
        
        // Header section
        mainContent.getChildren().add(createHeaderSection());
        
        // Template selection section
        mainContent.getChildren().add(createTemplateSelectionSection());
        
        // Configuration sections
        mainContent.getChildren().addAll(
            createOpeningSection(),
            createAnalysisSection(),
            createReactionSection(),
            createEndgameSection()
        );
        
        // Preview and testing section
        mainContent.getChildren().add(createPreviewSection());
        
        // Action buttons
        mainContent.getChildren().add(createActionButtonsSection());
        
        scrollPane.setContent(mainContent);
        tab.setContent(scrollPane);
        
        // Load initial data
        loadTemplates();
    }
    
    private VBox createHeaderSection() {
        VBox header = new VBox(10);
        header.setAlignment(Pos.CENTER);
        
        Label title = new Label("Conversation Template Designer");
        title.setFont(Font.font("System", FontWeight.BOLD, 24));
        title.setTextFill(Color.DARKBLUE);
        
        Label subtitle = new Label("Design dynamic conversation flows for chess master dialogues");
        subtitle.setFont(Font.font("System", 14));
        subtitle.setTextFill(Color.GRAY);
        
        header.getChildren().addAll(title, subtitle);
        return header;
    }
    
    private VBox createTemplateSelectionSection() {
        VBox section = new VBox(10);
        section.getStyleClass().add("config-section");
        
        Label sectionTitle = new Label("📋 Template Selection");
        sectionTitle.setFont(Font.font("System", FontWeight.BOLD, 16));
        
        HBox selectionRow = new HBox(10);
        selectionRow.setAlignment(Pos.CENTER_LEFT);
        
        Label templateLabel = new Label("Current Template:");
        templateSelector = new ComboBox<>();
        templateSelector.setPrefWidth(200);
        templateSelector.setOnAction(e -> loadSelectedTemplate());
        
        Button newButton = new Button("New");
        newButton.setOnAction(e -> createNewTemplate());
        
        Button duplicateButton = new Button("Duplicate");
        duplicateButton.setOnAction(e -> duplicateCurrentTemplate());
        
        Button deleteButton = new Button("Delete");
        deleteButton.getStyleClass().add("danger-button");
        deleteButton.setOnAction(e -> deleteCurrentTemplate());
        
        selectionRow.getChildren().addAll(templateLabel, templateSelector, newButton, duplicateButton, deleteButton);
        
        // Template details
        VBox detailsBox = new VBox(5);
        
        HBox nameRow = new HBox(10);
        nameRow.setAlignment(Pos.CENTER_LEFT);
        Label nameLabel = new Label("Template Name:");
        nameLabel.setPrefWidth(120);
        templateNameField = new TextField();
        templateNameField.setPrefWidth(300);
        templateNameField.textProperty().addListener((obs, oldVal, newVal) -> updateTemplateName());
        nameRow.getChildren().addAll(nameLabel, templateNameField);
        
        Label descLabel = new Label("Description:");
        templateDescriptionArea = new TextArea();
        templateDescriptionArea.setPrefRowCount(2);
        templateDescriptionArea.setMaxHeight(60);
        templateDescriptionArea.textProperty().addListener((obs, oldVal, newVal) -> updateTemplateDescription());
        
        detailsBox.getChildren().addAll(nameRow, descLabel, templateDescriptionArea);
        
        section.getChildren().addAll(sectionTitle, selectionRow, detailsBox);
        return section;
    }
    
    private VBox createOpeningSection() {
        VBox section = new VBox(15);
        section.getStyleClass().add("config-section");
        
        Label sectionTitle = new Label("🚀 Opening Conversations");
        sectionTitle.setFont(Font.font("System", FontWeight.BOLD, 16));
        
        Label description = new Label("Configuration for game opening discussions between masters");
        description.getStyleClass().add("section-description");
        
        GridPane grid = new GridPane();
        grid.setHgap(20);
        grid.setVgap(10);
        
        // Turn controls
        openingMinTurns = new SliderWithLabel("Min Turns:", 1, 10, 3);
        openingMaxTurns = new SliderWithLabel("Max Turns:", 2, 15, 6);
        openingResponseRate = new SliderWithLabel("Response Rate:", 0.1, 1.0, 0.85, true);
        openingInterval = new SliderWithLabel("Interval (ms):", 1000, 5000, 2500);
        
        // Add change listeners for validation
        openingMinTurns.valueProperty().addListener((obs, oldVal, newVal) -> {
            if (newVal.intValue() >= openingMaxTurns.getValue()) {
                openingMaxTurns.setValue(newVal.intValue() + 1);
            }
            updateConfiguration();
        });
        
        openingMaxTurns.valueProperty().addListener((obs, oldVal, newVal) -> {
            if (newVal.intValue() <= openingMinTurns.getValue()) {
                openingMinTurns.setValue(newVal.intValue() - 1);
            }
            updateConfiguration();
        });
        
        openingResponseRate.valueProperty().addListener((obs, oldVal, newVal) -> updateConfiguration());
        openingInterval.valueProperty().addListener((obs, oldVal, newVal) -> updateConfiguration());
        
        grid.add(openingMinTurns, 0, 0);
        grid.add(openingMaxTurns, 1, 0);
        grid.add(openingResponseRate, 0, 1);
        grid.add(openingInterval, 1, 1);
        
        section.getChildren().addAll(sectionTitle, description, grid);
        return section;
    }
    
    private VBox createAnalysisSection() {
        VBox section = new VBox(15);
        section.getStyleClass().add("config-section");
        
        Label sectionTitle = new Label("🔍 Position Analysis");
        sectionTitle.setFont(Font.font("System", FontWeight.BOLD, 16));
        
        Label description = new Label("Configuration for in-depth position analysis discussions");
        description.getStyleClass().add("section-description");
        
        GridPane grid = new GridPane();
        grid.setHgap(20);
        grid.setVgap(10);
        
        analysisMinTurns = new SliderWithLabel("Min Turns:", 1, 10, 4);
        analysisMaxTurns = new SliderWithLabel("Max Turns:", 3, 20, 8);
        analysisResponseRate = new SliderWithLabel("Response Rate:", 0.1, 1.0, 0.80, true);
        analysisInterval = new SliderWithLabel("Interval (ms):", 1000, 5000, 2500);
        
        // Add change listeners
        analysisMinTurns.valueProperty().addListener((obs, oldVal, newVal) -> {
            if (newVal.intValue() >= analysisMaxTurns.getValue()) {
                analysisMaxTurns.setValue(newVal.intValue() + 1);
            }
            updateConfiguration();
        });
        
        analysisMaxTurns.valueProperty().addListener((obs, oldVal, newVal) -> {
            if (newVal.intValue() <= analysisMinTurns.getValue()) {
                analysisMinTurns.setValue(newVal.intValue() - 1);
            }
            updateConfiguration();
        });
        
        analysisResponseRate.valueProperty().addListener((obs, oldVal, newVal) -> updateConfiguration());
        analysisInterval.valueProperty().addListener((obs, oldVal, newVal) -> updateConfiguration());
        
        grid.add(analysisMinTurns, 0, 0);
        grid.add(analysisMaxTurns, 1, 0);
        grid.add(analysisResponseRate, 0, 1);
        grid.add(analysisInterval, 1, 1);
        
        section.getChildren().addAll(sectionTitle, description, grid);
        return section;
    }
    
    private VBox createReactionSection() {
        VBox section = new VBox(15);
        section.getStyleClass().add("config-section");
        
        Label sectionTitle = new Label("⚡ Quick Reactions");
        sectionTitle.setFont(Font.font("System", FontWeight.BOLD, 16));
        
        Label description = new Label("Configuration for reactions to brilliant moves, blunders, and tactical shots");
        description.getStyleClass().add("section-description");
        
        GridPane grid = new GridPane();
        grid.setHgap(20);
        grid.setVgap(10);
        
        reactionMinTurns = new SliderWithLabel("Min Turns:", 1, 8, 2);
        reactionMaxTurns = new SliderWithLabel("Max Turns:", 2, 12, 5);
        reactionResponseRate = new SliderWithLabel("Response Rate:", 0.1, 1.0, 0.75, true);
        reactionInterval = new SliderWithLabel("Interval (ms):", 500, 4000, 2000);
        
        // Add change listeners
        reactionMinTurns.valueProperty().addListener((obs, oldVal, newVal) -> {
            if (newVal.intValue() >= reactionMaxTurns.getValue()) {
                reactionMaxTurns.setValue(newVal.intValue() + 1);
            }
            updateConfiguration();
        });
        
        reactionMaxTurns.valueProperty().addListener((obs, oldVal, newVal) -> {
            if (newVal.intValue() <= reactionMinTurns.getValue()) {
                reactionMinTurns.setValue(newVal.intValue() - 1);
            }
            updateConfiguration();
        });
        
        reactionResponseRate.valueProperty().addListener((obs, oldVal, newVal) -> updateConfiguration());
        reactionInterval.valueProperty().addListener((obs, oldVal, newVal) -> updateConfiguration());
        
        grid.add(reactionMinTurns, 0, 0);
        grid.add(reactionMaxTurns, 1, 0);
        grid.add(reactionResponseRate, 0, 1);
        grid.add(reactionInterval, 1, 1);
        
        section.getChildren().addAll(sectionTitle, description, grid);
        return section;
    }
    
    private VBox createEndgameSection() {
        VBox section = new VBox(15);
        section.getStyleClass().add("config-section");
        
        Label sectionTitle = new Label("🏁 Endgame Discussions");
        sectionTitle.setFont(Font.font("System", FontWeight.BOLD, 16));
        
        Label description = new Label("Configuration for game conclusion and post-game analysis");
        description.getStyleClass().add("section-description");
        
        GridPane grid = new GridPane();
        grid.setHgap(20);
        grid.setVgap(10);
        
        endgameMinTurns = new SliderWithLabel("Min Turns:", 1, 8, 3);
        endgameMaxTurns = new SliderWithLabel("Max Turns:", 3, 15, 6);
        endgameResponseRate = new SliderWithLabel("Response Rate:", 0.1, 1.0, 0.90, true);
        endgameInterval = new SliderWithLabel("Interval (ms):", 1500, 6000, 3000);
        
        // Add change listeners
        endgameMinTurns.valueProperty().addListener((obs, oldVal, newVal) -> {
            if (newVal.intValue() >= endgameMaxTurns.getValue()) {
                endgameMaxTurns.setValue(newVal.intValue() + 1);
            }
            updateConfiguration();
        });
        
        endgameMaxTurns.valueProperty().addListener((obs, oldVal, newVal) -> {
            if (newVal.intValue() <= endgameMinTurns.getValue()) {
                endgameMinTurns.setValue(newVal.intValue() - 1);
            }
            updateConfiguration();
        });
        
        endgameResponseRate.valueProperty().addListener((obs, oldVal, newVal) -> updateConfiguration());
        endgameInterval.valueProperty().addListener((obs, oldVal, newVal) -> updateConfiguration());
        
        grid.add(endgameMinTurns, 0, 0);
        grid.add(endgameMaxTurns, 1, 0);
        grid.add(endgameResponseRate, 0, 1);
        grid.add(endgameInterval, 1, 1);
        
        section.getChildren().addAll(sectionTitle, description, grid);
        return section;
    }
    
    private VBox createPreviewSection() {
        VBox section = new VBox(10);
        section.getStyleClass().add("config-section");
        
        Label sectionTitle = new Label("🔬 Template Preview & Testing");
        sectionTitle.setFont(Font.font("System", FontWeight.BOLD, 16));
        
        // Preview area
        Label previewLabel = new Label("Configuration Summary:");
        previewArea = new TextArea();
        previewArea.setEditable(false);
        previewArea.setPrefRowCount(8);
        previewArea.getStyleClass().add("preview-area");
        
        // Simulation controls
        HBox simulationControls = new HBox(10);
        simulationControls.setAlignment(Pos.CENTER_LEFT);
        
        Button runSimulationButton = new Button("🧪 Run Simulation");
        runSimulationButton.setOnAction(e -> runTemplateSimulation());
        
        ComboBox<String> triggerTypeSelector = new ComboBox<>();
        triggerTypeSelector.getItems().addAll("Opening", "Position Analysis", "Quick Reaction", "Endgame");
        triggerTypeSelector.setValue("Opening");
        
        simulationProgress = new ProgressBar(0);
        simulationProgress.setPrefWidth(150);
        simulationProgress.setVisible(false);
        
        simulationControls.getChildren().addAll(
            new Label("Test Trigger:"), triggerTypeSelector, runSimulationButton, simulationProgress
        );
        
        // Results area
        simulationResults = new Label("Run a simulation to see conversation flow prediction");
        simulationResults.getStyleClass().add("simulation-results");
        
        section.getChildren().addAll(sectionTitle, previewLabel, previewArea, simulationControls, simulationResults);
        return section;
    }
    
    private HBox createActionButtonsSection() {
        HBox buttonBox = new HBox(15);
        buttonBox.setAlignment(Pos.CENTER);
        buttonBox.setPadding(new Insets(20, 0, 0, 0));
        
        Button saveButton = new Button("💾 Save Template");
        saveButton.getStyleClass().add("primary-button");
        saveButton.setOnAction(e -> saveCurrentTemplate());
        
        Button applyButton = new Button("🚀 Apply to Game");
        applyButton.getStyleClass().add("success-button");
        applyButton.setOnAction(e -> applyTemplateToGame());
        
        Button resetButton = new Button("🔄 Reset");
        resetButton.setOnAction(e -> resetCurrentTemplate());
        
        Button exportButton = new Button("📤 Export Template");
        exportButton.setOnAction(e -> exportTemplate());
        
        buttonBox.getChildren().addAll(saveButton, applyButton, resetButton, exportButton);
        return buttonBox;
    }
    
    // Event handlers and utility methods
    private void loadTemplates() {
        logger.info("📋 Loading conversation templates...");
        templateSelector.getItems().clear();
        templateSelector.getItems().addAll("Minimal", "Engaging", "Intense", "Collaborative");
        templateSelector.setValue("Engaging");
        loadSelectedTemplate();
    }
    
    private void loadSelectedTemplate() {
        String selectedTemplate = templateSelector.getValue();
        if (selectedTemplate != null) {
            logger.info("📥 Loading template: " + selectedTemplate);
            ConversationTemplate template = configManager.getConversationTemplate(selectedTemplate);
            if (template != null) {
                populateUIFromTemplate(template);
                updatePreview();
            }
        }
    }
    
    private void populateUIFromTemplate(ConversationTemplate template) {
        templateNameField.setText(template.getName());
        templateDescriptionArea.setText(template.getDescription());
        
        // Set opening values
        openingMinTurns.setValue(template.getOpeningMinTurns());
        openingMaxTurns.setValue(template.getOpeningMaxTurns());
        openingResponseRate.setValue(template.getOpeningResponseRate());
        openingInterval.setValue(template.getOpeningInterval());
        
        // Set analysis values
        analysisMinTurns.setValue(template.getAnalysisMinTurns());
        analysisMaxTurns.setValue(template.getAnalysisMaxTurns());
        analysisResponseRate.setValue(template.getAnalysisResponseRate());
        analysisInterval.setValue(template.getAnalysisInterval());
        
        // Set reaction values
        reactionMinTurns.setValue(template.getReactionMinTurns());
        reactionMaxTurns.setValue(template.getReactionMaxTurns());
        reactionResponseRate.setValue(template.getReactionResponseRate());
        reactionInterval.setValue(template.getReactionInterval());
        
        // Set endgame values
        endgameMinTurns.setValue(template.getEndgameMinTurns());
        endgameMaxTurns.setValue(template.getEndgameMaxTurns());
        endgameResponseRate.setValue(template.getEndgameResponseRate());
        endgameInterval.setValue(template.getEndgameInterval());
    }
    
    private void updateConfiguration() {
        updatePreview();
    }
    
    private void updateTemplateName() {
        updatePreview();
    }
    
    private void updateTemplateDescription() {
        updatePreview();
    }
    
    private void updatePreview() {
        StringBuilder preview = new StringBuilder();
        preview.append("Template: ").append(templateNameField.getText()).append("\\n");
        preview.append("Description: ").append(templateDescriptionArea.getText()).append("\\n\\n");
        
        preview.append("OPENING CONVERSATIONS:\\n");
        preview.append(String.format("  Turns: %d-%d, Response Rate: %.0f%%, Interval: %.0fms\\n",
                (int) openingMinTurns.getValue(), (int) openingMaxTurns.getValue(),
                openingResponseRate.getValue() * 100, openingInterval.getValue()));
        
        preview.append("\\nPOSITION ANALYSIS:\\n");
        preview.append(String.format("  Turns: %d-%d, Response Rate: %.0f%%, Interval: %.0fms\\n",
                (int) analysisMinTurns.getValue(), (int) analysisMaxTurns.getValue(),
                analysisResponseRate.getValue() * 100, analysisInterval.getValue()));
        
        preview.append("\\nQUICK REACTIONS:\\n");
        preview.append(String.format("  Turns: %d-%d, Response Rate: %.0f%%, Interval: %.0fms\\n",
                (int) reactionMinTurns.getValue(), (int) reactionMaxTurns.getValue(),
                reactionResponseRate.getValue() * 100, reactionInterval.getValue()));
        
        preview.append("\\nENDGAME DISCUSSIONS:\\n");
        preview.append(String.format("  Turns: %d-%d, Response Rate: %.0f%%, Interval: %.0fms\\n",
                (int) endgameMinTurns.getValue(), (int) endgameMaxTurns.getValue(),
                endgameResponseRate.getValue() * 100, endgameInterval.getValue()));
        
        previewArea.setText(preview.toString());
    }
    
