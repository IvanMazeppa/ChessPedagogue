<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with explicit Material Components support -->
    <style name="Theme.ChessPedagogue" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/bronze</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/parchment</item>
        <item name="backgroundColor">@color/ivory</item>

        <!-- CRITICAL: Explicit FAB styling to prevent theme conflicts -->
        <item name="floatingActionButtonStyle">@style/Widget.MaterialComponents.FloatingActionButton</item>

        <!-- Ensure Material Components are properly supported -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="cardViewStyle">@style/Widget.MaterialComponents.CardView</item>

        <!-- Additional Material Components theme attributes -->
        <item name="colorSurface">@color/parchment</item>
        <item name="colorOnSurface">@color/text_on_light</item>
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/white</item>
    </style>

    <!-- NEW: No Action Bar variant for ChessMasterSelectionActivity -->
    <style name="Theme.ChessPedagogue.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Inherit all the same colors and styling -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/bronze</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@color/parchment</item>
        <item name="backgroundColor">@color/ivory</item>

        <!-- Same Material Components support -->
        <item name="floatingActionButtonStyle">@style/Widget.MaterialComponents.FloatingActionButton</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="cardViewStyle">@style/Widget.MaterialComponents.CardView</item>
        <item name="colorSurface">@color/parchment</item>
        <item name="colorOnSurface">@color/text_on_light</item>
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/white</item>
    </style>
</resources>