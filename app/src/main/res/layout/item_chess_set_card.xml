<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chessSetCard"
    style="@style/WoodCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_surface"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with title and selection indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textChessSetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chess Set Name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_light"
                    android:fontFamily="serif" />

                <TextView
                    android:id="@+id/textChessSetDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chess set description"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2sp" />
            </LinearLayout>

            <!-- Selection Indicator -->
            <ImageView
                android:id="@+id/selectedIndicator"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/checkbox_on_background"
                android:tint="@color/gold"
                android:visibility="gone"
                android:contentDescription="Selected chess set indicator" />
        </LinearLayout>

        <!-- Chess Pieces Preview Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preview:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <GridLayout
            android:id="@+id/previewGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="2"
            android:layout_gravity="center"
            android:padding="8dp"
            android:background="@drawable/wood_panel_bg"
            android:elevation="2dp" />

        <!-- Visual separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/shadow_light"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>