<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- Premium Voice Toggle -->
    <Switch
        android:id="@+id/switch_premium_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="16dp"
        android:text="Use OpenAI Premium Voice"
        android:textSize="16sp" />

    <!-- Voice Persona Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="Voice Persona"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radio_group_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <RadioButton
            android:id="@+id/radio_voice_grandmaster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grandmaster (Wise, Authoritative)" />

        <RadioButton
            android:id="@+id/radio_voice_tutor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tutor (Patient, Encouraging)" />

        <RadioButton
            android:id="@+id/radio_voice_friendly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Friendly (Cheerful, Energetic)" />

        <RadioButton
            android:id="@+id/radio_voice_neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Neutral (Balanced, Clear)" />
    </RadioGroup>

    <!-- Model Quality -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="Voice Quality"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radio_group_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <RadioButton
            android:id="@+id/radio_model_standard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Standard Quality (Lower cost)" />

        <RadioButton
            android:id="@+id/radio_model_premium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Premium Quality (Higher fidelity)" />
    </RadioGroup>

    <!-- Token Usage Estimate -->
    <TextView
        android:id="@+id/text_token_estimate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="16dp"
        android:textStyle="italic"
        android:text="Estimated cost: ~$0.015 per 1000 characters" />

    <!-- Test Voice Button -->
    <Button
        android:id="@+id/button_test_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:text="Test Selected Voice" />

</LinearLayout>